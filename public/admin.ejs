<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Admin Dashboard</title>


<style>

/* ================= GOOGLE FONT ================= */
@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;800&display=swap');

/* ================= GLOBAL ================= */

*{
  margin:0;
  padding:0;
  box-sizing:border-box;
}

body{
  font-family: 'Poppins', sans-serif;
  background: linear-gradient(-45deg, #8e2de2, #4a00e0, #ff6ec4, #7873f5);
  background-size: 400% 400%;
  animation: gradientMove 12s ease infinite;
  color:white;
  overflow-x:hidden;
}

@keyframes gradientMove {
  0% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}

/* ================= TOP BAR ================= */

.top-bar{
  padding:25px 8%;
  display:flex;
  justify-content:space-between;
  align-items:center;
  backdrop-filter: blur(25px);
  background: rgba(255,255,255,0.08);
  position:sticky;
  top:0;
  z-index:1000;
}

.top-bar h1{
  font-size:26px;
  font-weight:700;
}

/* Logout Button */
.logout-btn{
  padding:12px 30px;
  border-radius:60px;
  border:none;
  font-weight:600;
  cursor:pointer;
  background: linear-gradient(135deg, #ffffff, #e0e0ff);
  color:#4a00e0;
  transition:0.4s;
  box-shadow:0 10px 30px rgba(0,0,0,0.4);
}

.logout-btn:hover{
  transform:translateY(-5px) scale(1.07);
  box-shadow:0 20px 45px rgba(255,255,255,0.6);
}

/* ================= BUTTON GROUP ================= */

.button-group{
  display:flex;
  flex-wrap:wrap;
  justify-content:center;
  gap:25px;
  margin:60px 8%;
}

.admin-btn{
  padding:14px 30px;
  font-size:15px;
  border-radius:60px;
  border:none;
  font-weight:600;
  cursor:pointer;
  background: linear-gradient(135deg, #ff6ec4, #7873f5);
  color:white;
  transition:0.4s ease;
  box-shadow:0 15px 35px rgba(0,0,0,0.4);
}

.admin-btn:hover{
  transform:translateY(-6px) scale(1.07);
  box-shadow:0 25px 50px rgba(0,0,0,0.6);
}

/* ================= DATA SECTION ================= */

.data-section{
  margin:0 8% 80px 8%;
  backdrop-filter: blur(25px);
  background: rgba(255,255,255,0.08);
  padding:35px;
  border-radius:25px;
  border:1px solid rgba(255,255,255,0.2);
  box-shadow:0 25px 60px rgba(0,0,0,0.5);
  overflow-x:auto;
  transition:0.4s;
}

.data-section:hover{
  transform:translateY(-8px);
}

/* ================= TABLE ================= */

table{
  width:100%;
  border-collapse:collapse;
  min-width:600px;
}

th,td{
  padding:14px;
  text-align:left;
  font-size:14px;
}

th{
  font-weight:600;
  border-bottom:1px solid rgba(255,255,255,0.3);
}

td{
  border-bottom:1px solid rgba(255,255,255,0.1);
}

tr:hover{
  background: rgba(255,255,255,0.08);
}

/* ================= RESPONSIVE ================= */

@media(max-width:768px){

  .top-bar{
    flex-direction:column;
    gap:15px;
    text-align:center;
  }

  .button-group{
    flex-direction:column;
    align-items:center;
  }

  .admin-btn{
    width:80%;
  }
}

</style>



</head>

<body>

<div class="top-bar">
  <h1>Admin Dashboard</h1>
  <button class="logout-btn" onclick="logout()">Logout</button>
</div>

<div class="button-group">
  <button class="admin-btn" onclick="loadData('useraccounts')">User Accounts</button>
  <button class="admin-btn" onclick="loadData('contacts')">Contacts</button>
  <button class="admin-btn" onclick="loadData('customers')">Customers</button>
  <button class="admin-btn" onclick="loadData('products')">Products</button>
</div>

<div class="data-section">
  <div id="dataContainer"></div>
</div>

<script>
function loadData(type) {
  fetch(`/admin/data/${type}`)
    .then(res => res.json())
    .then(data => {
      const container = document.getElementById('dataContainer');

      if (!data.length) {
        container.innerHTML = `
          <p style="text-align:center; color:#777; font-size:16px;">
            No data found for ${type}.
          </p>`;
        return;
      }

      let table = '<table><tr>';
      Object.keys(data[0]).forEach(key => {
        table += `<th>${key}</th>`;
      });
      table += '</tr>';

      data.forEach(row => {
        table += '<tr>';
        Object.entries(row).forEach(([key, value]) => {
          if (key === 'price') {
            value = '₹' + Number(value).toLocaleString();
          }
          table += `<td>${value}</td>`;
        });
        table += '</tr>';
      });

      table += '</table>';
      container.innerHTML = table;
    })
    .catch(err => {
      console.error('Error loading data:', err);
    });
}

function logout(){
  window.location.href = '/';
}
</script>

</body>
</html>
