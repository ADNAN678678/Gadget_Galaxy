<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gadget Galaxy</title>
    <link rel="stylesheet" href="main.css">
    <link rel="website icon" type="png" href="headlogo4.png">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;800&display=swap" rel="stylesheet">

</head>

<body>

<!-- Navbar -->
<nav class="nav">
    <div class="nav-left">
        <img src="logo.png" class="nav-logo">
        <h2>Gadget Galaxy</h2>
    </div>
    <ul class="nav-links">
        <li><a href="/home">Home</a></li>
        <li><a href="#about">About</a></li>
        <li><a href="/contact">Contact</a></li>
    </ul>
</nav>

<!-- Hero Section -->
<section class="hero">
    <div class="hero-text">
        <h1>
            Welcome to Gadget Galaxy:<br>
            Your Hub for Cutting-Edge Technology!
        </h1>
        <h3>Join Us on Your Tech Journey</h3>
        <button onclick="location.href='/products'">Products</button>
    </div>

    <div class="hero-image">
    <img src="hero-1.png" alt="3D Tech Showcase">
</div>

</section>

<!-- About Section -->
<section class="about-section" id="about">
    <div class="about-images">
        <img src="ad1.jpg">
        <img src="me.jpg">
    </div>

    <div class="about-text">
        <h1>Get to Know Me</h1>
        <h4>I am Md. Adnan, Founder of Gadget Galaxy.</h4>
        <p>
            At Gadget Galaxy, we’re passionate about technology and dedicated to bringing you the best gadgets available.
            Browse our collections and find your next favorite tech companion today!
            <br><br>
            * Return Policy within 7 days.<br>
            * Refund within 2-3 business days.<br>
            * Damaged product can be replaced.
        </p>
        <img src="ad2.jpg" class="about-small">
    </div>
</section>

<!-- Footer -->
<footer class="footer">
    <div class="footer-left">
        <img src="logo.png">
        <p>
            At Gadget Galaxy, we’re passionate about technology and 
            bringing you the best gadgets available.
        </p>
    </div>

    <div class="footer-right">
        <button onclick="location.href='/logout'">Logout</button>
    </div>
</footer>


<script>
const elements = document.querySelectorAll('.hero-text, .hero-image, .about-text, .about-images');

const observer = new IntersectionObserver(entries => {
  entries.forEach(entry => {
    if (entry.isIntersecting) {
      entry.target.style.opacity = 1;
      entry.target.style.transform = "translateY(0)";
    }
  });
}, { threshold: 0.2 });

elements.forEach(el => {
  el.style.opacity = 0;
  el.style.transform = "translateY(40px)";
  el.style.transition = "all 0.8s ease";
  observer.observe(el);
});
</script>

</body>
</html>
