<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact Us - Gadget Galaxy</title>
    <link rel="stylesheet" href="contact.css">
    <link rel="website icon" type="png" href="headlogo4.png">
</head>
<body>

<!-- Navbar -->
<nav class="nav">
    <a href="/home">Home</a>
    <div class="nav-brand">
        <img src="logo.png" alt="Logo">
        <h2>Gadget Galaxy</h2>
    </div>
</nav>

<!-- Contact Section -->
<section class="contact-section">

    <!-- Left Side: Form -->
    <div class="contact-form">
        <h2>Contact Us</h2>

        <form action="/contact" method="post">

            <div class="row">
                <div class="field">
                    <label>First Name</label>
                    <input type="text" name="FirstName" required>
                </div>

                <div class="field">
                    <label>Last Name</label>
                    <input type="text" name="LastName" required>
                </div>
            </div>

            <div class="row">
                <div class="field">
                    <label>Email</label>
                    <input type="email" name="Email" required>
                </div>

                <div class="field">
                    <label>Phone Number</label>
                    <input type="number" name="PhoneNumber" required>
                </div>
            </div>

            <div class="field full">
                <label>Your Message</label>
                <textarea name="Comment" rows="4"></textarea>
            </div>

            <button type="submit">Submit</button>
        </form>
    </div>

    <!-- Right Side: Info -->
    <div class="contact-info">
        <h3>We'd Love to Hear From You!</h3>
        <p>
            At Gadget Galaxy, we’re passionate about technology and dedicated to 
            bringing you the best gadgets available.
            Browse our collections and find your next favorite tech companion today!
        </p>

        <div class="social">
            <button onclick="location.href='https://www.instagram.com/adnan_678__/'">
                <img src="instagram.png" alt="Instagram">
            </button>

            <button onclick="location.href='https://www.facebook.com/profile.php?id=100052871384000'">
                <img src="facebook.png" alt="Facebook">
            </button>
        </div>
    </div>

</section>

<!-- Footer -->
<footer class="footer">
    <div class="footer-left">
        <img src="logo.png">
        <p>
            At Gadget Galaxy, we’re passionate about technology and 
            bringing you the best gadgets available.
        </p>
    </div>
</footer>

</body>
</html>
